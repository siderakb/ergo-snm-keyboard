# Set default behavior to automatically normalize line endings
* text=auto

# KiCad requires automatic normalization
# https://github.com/github-linguist/linguist/blob/main/lib/linguist/languages.yml
*.kicad_pro text eol=lf linguist-detectable
*.kicad_prl text eol=lf linguist-detectable
*.kicad_pcb text eol=lf linguist-detectable
*.kicad_sch text eol=lf linguist-detectable
*.kicad_dru text eol=lf linguist-detectable
*.kicad_mod text eol=lf linguist-detectable
*.kicad_sym text eol=lf linguist-detectable
*.kicad_wks text eol=lf linguist-detectable
fp-lib-table text eol=lf
sym-lib-table text eol=lf

# FreeCAD
*.FCStd binary

# Explicitly declare the binary files
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.ico binary
*.webp binary
*.bmp binary
*.pdf binary
